{
  "label": "Studio (show/wip/shots|assets)",
  "description": "show/wip/TYPE/SHOT|NAME/task/out/NAME/NAME.frame.ext, where NAME is SHOT|NAME_task_variant_vVERSION_[extra-]gGEN_colorspace. 'type' picks shots or assets and reveals the shot number or the asset name. 'extra' is optional free text; the generation is counted from what is already on disk, so every run gets its own folder. Tasks cover AI generation work only. The mount point defaults per operating system and feeds the absolute path outputs.",
  "tokens": {
    "show": {
      "label": "Show code",
      "charset": "any",
      "default": "SHOW"
    },
    "type": {
      "label": "Type",
      "default": "shots",
      "presets": [
        "shots",
        "assets"
      ],
      "allow_custom": false,
      "reveals": {
        "shots": [
          "shot"
        ],
        "assets": [
          "name"
        ]
      }
    },
    "shot": {
      "label": "Shot number",
      "type": "int",
      "pad": 3,
      "prefix": "sh",
      "default": 10,
      "step": 10
    },
    "name": {
      "label": "Asset name",
      "charset": "alnum",
      "allow": "-",
      "default": "asset"
    },
    "task": {
      "label": "Task",
      "charset": "alnum",
      "case": "lower",
      "default": "imggen",
      "presets": [
        "imggen",
        "vidgen",
        "audgen",
        "3dgen",
        "retouch",
        "restyle",
        "relight",
        "roto",
        "aov",
        "upscale",
        "interp"
      ],
      "allow_custom": true,
      "allow": "-"
    },
    "variant": {
      "label": "Variant",
      "charset": "alnum",
      "case": "lower",
      "default": "main",
      "allow": "-"
    },
    "version": {
      "label": "Version",
      "type": "int",
      "pad": 3,
      "prefix": "v",
      "default": 1
    },
    "extra": {
      "label": "Extra",
      "charset": "alnum",
      "case": "lower",
      "allow": "-",
      "optional": true,
      "default": ""
    },
    "gen": {
      "label": "Generation",
      "type": "counter",
      "pad": 3,
      "prefix": "g",
      "start": 1
    },
    "colorspace": {
      "label": "Colorspace",
      "charset": "alnum",
      "case": "lower",
      "default": "rec709",
      "presets": [
        "rec709",
        "acescg"
      ],
      "allow_custom": false
    },
    "frame": {
      "label": "First frame",
      "type": "int",
      "pad": 4,
      "default": 1001
    },
    "ext": {
      "label": "Extension",
      "charset": "alnum",
      "case": "lower",
      "default": "exr",
      "presets": [
        "exr",
        "png",
        "tif",
        "tiff",
        "jpg",
        "dpx",
        "webp",
        "mov",
        "mp4",
        "mxf",
        "cube",
        "cdl"
      ],
      "allow_custom": true
    },
    "mount": {
      "label": "Mount point",
      "charset": "any",
      "optional": true,
      "os": {
        "windows": "C:/projects",
        "macos": "/Volumes/projects",
        "linux": "/mnt/projects"
      }
    }
  },
  "root": [
    "{mount}"
  ],
  "folders": [
    "{show}",
    "wip",
    "{type}",
    "[{shot}][{name}]",
    "{task}",
    "out",
    "[{shot}][{name}]_{task}_{variant}_{version}_[{extra}-]{gen}_{colorspace}"
  ],
  "file": "[{shot}][{name}]_{task}_{variant}_{version}_[{extra}-]{gen}_{colorspace}",
  "filename": "{basename}.{frame}.{ext}",
  "shot_id": "[{shot}][{name}]"
}
